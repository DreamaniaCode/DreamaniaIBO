RewriteEngine On
RewriteBase /

# Redirect legacy static landing.html to dynamic landing.php with live database pricing
RewriteRule ^landing\.html$ landing.php [R=301,L]
RewriteRule ^landing/?$ landing.php [QSA,L]

# Download route (including short Downloader code 7454701 and APK filenames)
RewriteRule ^(download|app\.apk|DreamaniaPlayer\.apk|DreamaniaIBOPro\.apk|7454701)/?$ api.php?action=download_apk [QSA,L]

# Admin & Reseller Portal routes
RewriteRule ^(admin|reseller|portal|panel|login)/?$ index.php?panel=1 [QSA,L]

# End-user device & playlist portal (inspired by iboplayer.com)
RewriteRule ^(device|upload|manage-playlist|manage|playlist)/?$ device.php [QSA,L]

# Reseller credits wholesale portal
RewriteRule ^credits/?$ credits.php [QSA,L]

# Stop processing for other real files and directories (css, js, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API routes
RewriteRule ^authenticate/?$ api.php?action=authenticate [QSA,L]
RewriteRule ^playlists/?$ api.php?action=playlists [QSA,L]
RewriteRule ^playlists/delete/?$ api.php?action=delete [QSA,L]
RewriteRule ^delete/?$ api.php?action=delete [QSA,L]
RewriteRule ^parent-control/update/?$ api.php?action=parent_control [QSA,L]
RewriteRule ^player_api\.php$ api.php [QSA,L]

# Main portal
RewriteRule ^ index.php [QSA,L]
